/*====================================================================
ddl script : create gold layer 
====================================================================
script purpose : the script create views for the gold layer in the data warehouse
each view perform transformations and combines data from silver layer 
to produce a clean , enriched and business ready dataset

usage : 
    -these views can be queried directly for reporting and analytics .
====================================================================*/
-----------------------------------------------------------
create dimension : gold.dim_customers 
-----------------------------------------------------------
create view gold.dim_customers as (

select 
row_number() over(order by ci.cst_id) as customer_key ,
ci.cst_id as customer_id ,
ci.cst_key as customer_number,
ci.cst_firstname as first_name,
ci.cst_lastname as last_name, 
a1.cntry as country ,
case 
	when ci.cst_gndr !='n/a' then ci.cst_gndr 
	else coalesce(az.gen , 'n/a')
end as gender ,
az.BDATE as birth_date,
ci.cst_marital_status as marital_status,
ci.cst_create_date as create_date


from silver.crm_cus_info as ci
left join silver.erp_cust_az12 az
on ci.cst_key = az.cid
left join silver.erp_loc_a101 a1
on a1.cid=ci.cst_key )  ;


  GO
------------------------------------------------------------------------------------------------------------
create dimension : gold.dim_products
------------------------------------------------------------------------------------------------------------
create view gold.dim_products as(
select
    row_number() over(order by pr.prd_start_dt , pr.prd_key) as product_key ,
	pr.prd_id as product_id,
	pr.prd_key as product_number,
	pr.prd_nm as product_name,
	pr.cat_id as category_id, 
	px.cat as category,
	px.subcat as subcategory,
	px.maintenance ,
	pr.prd_cost as cost ,
	pr.prd_line as product_line,
	pr.prd_start_dt as product_start_date 
	
from silver.crm_prd_info as pr
left join silver.erp_px_cat_g1v2 as px
on px.id=pr.cat_id 
where pr.prd_end_dt is null -- filter out all historical data 
) ;
 GO 

 ------------------------------------------------------------------------------------------------------
  create fact : gold.fact_sales 

 ------------------------------------------------------------------------------------------------------
  create view gold.fact_sales as (
select sr.sls_ord_num as order_name,
       pr.product_key ,
       cr.customer_key ,
       sr.sls_order_dt as order_date,
       sr.sls_ship_dt as shipping_date, 
       sr.sls_due_dt as due_date ,
       sr.sls_sales as sales_amount ,
       sr.sls_quantity as quantity,
       sr.sls_price as price
from silver.crm_sls_info as sr
left join gold.dim_products as pr
on sr.sls_prd_key=pr.product_number
left join gold.dim_customers as cr 
on cr.customer_id=sr.sls_cust_id )
